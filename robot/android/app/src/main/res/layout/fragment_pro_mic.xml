<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi Mic Pro / Internet Mic Pro (shared layout), same robotic look as the mic pages.
     Top: kicker, title, link pill + link delay + battery chips. Middle: the robot camera window
     and what Xiaozhi heard / answered. Lower: drive pad (left) and hold-to-talk orb (right),
     then the big red STOP bar and the scan button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="28dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/kickerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.24"
        android:text="@string/pro_kicker_lan"
        android:textColor="#6FA8B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/tile_wifi_mic_pro"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/connectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/mic_link_pill"
            android:drawableStart="@drawable/mic_status_dot"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/voice_relay_searching"
            android:textAllCaps="true"
            android:textColor="#CFF6FF"
            android:textSize="11sp"
            tools:text="Linked · Joy 4" />

        <TextView
            android:id="@+id/pingText"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/mic_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/pro_ping_none"
            android:textColor="#8FA9B3"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="85 ms" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/mic_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/pro_battery_none"
            android:textColor="#8FA9B3"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🔋 72%" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/camBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/mic_cam_frame"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="120dp"
        android:padding="1dp">

        <ImageView
            android:id="@+id/camImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pro_cam_title"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/camHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:text="@string/pro_cam_off"
            android:textColor="#6FA8B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/camTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/mic_chip"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/pro_cam_tag_off"
            android:textColor="#8FA9B3"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/mic_cam_frame"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/heardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="@string/pro_heard_empty"
            android:textColor="#E6F9FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/saidText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="@string/pro_said_empty"
            android:textColor="#7FE7FF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Drive pad: hold an arrow to drive, let go to stop. -->
        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp">

            <ImageButton
                android:id="@+id/padUp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/mic_pad_btn"
                android:contentDescription="@string/pro_pad_forward"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_btn_arrow_upward"
                app:tint="#7FE7FF" />

            <ImageButton
                android:id="@+id/padLeft"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/mic_pad_btn"
                android:contentDescription="@string/pro_pad_left"
                android:padding="14dp"
                android:rotation="-90"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_btn_arrow_upward"
                app:tint="#7FE7FF" />

            <ImageButton
                android:id="@+id/padRight"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/mic_pad_btn"
                android:contentDescription="@string/pro_pad_right"
                android:padding="14dp"
                android:rotation="90"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_btn_arrow_upward"
                app:tint="#7FE7FF" />

            <ImageButton
                android:id="@+id/padDown"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/mic_pad_btn"
                android:contentDescription="@string/pro_pad_back"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_btn_arrow_downward"
                app:tint="#7FE7FF" />

            <TextView
                android:id="@+id/padLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="monospace"
                android:text="@string/pro_pad_label"
                android:textColor="#6FA8B8"
                android:textSize="10sp" />
        </FrameLayout>

        <!-- Hold-to-talk orb. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp">

                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/mic_ring_pulse" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/mic_ring_dashed" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:background="@drawable/mic_orb_idle"
                    android:contentDescription="@string/pro_hold_to_talk"
                    android:elevation="6dp"
                    android:padding="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic"
                    app:tint="#7FE7FF" />
            </FrameLayout>

            <org.openbot.app.robot.voice.MicLevelView
                android:id="@+id/levelBars"
                android:layout_width="90dp"
                android:layout_height="22dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/stateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.14"
                android:text="@string/pro_hold_to_talk"
                android:textAllCaps="true"
                android:textColor="#E6F9FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/mic_stop_btn"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:text="@string/pro_stop"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/scanQrButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/mic_scan_outline"
        android:drawableStart="@drawable/ic_qr_code"
        android:drawablePadding="10dp"
        android:drawableTint="#7FE7FF"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:minHeight="46dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/remote_mic_scan_qr"
        android:textAllCaps="true"
        android:textColor="#7FE7FF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
