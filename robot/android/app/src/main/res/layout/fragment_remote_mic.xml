<?xml version="1.0" encoding="utf-8"?>
<!-- Remote Mic: this phone's microphone feeds the Voice Control page on the phone that
     holds the robot link. Lean screen — title, connection pill, explanation card, a big
     mic orb with its streaming state under it, and a level bar that follows the voice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tile_remote_mic"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/connectionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/voice_capsule_bg"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/ic_voice_bluetooth"
        android:drawableTint="#636366"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/voice_relay_searching"
        android:textColor="#48484A"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Live on Pixel 8" />

    <TextView
        android:id="@+id/helpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/voice_card_bg"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:text="@string/remote_mic_help"
        android:textColor="#48484A"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/voice_mic_orb"
            android:contentDescription="@string/tile_remote_mic"
            android:elevation="3dp"
            android:padding="19dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/remote_mic_tap_to_start"
            android:textColor="#1C1C1E"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Listening — tap to stop" />

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/voice_capsule_bg">

            <View
                android:id="@+id/levelBar"
                android:layout_width="200dp"
                android:layout_height="6dp"
                android:background="#0A66D6"
                android:transformPivotX="0dp"
                android:scaleX="0" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
