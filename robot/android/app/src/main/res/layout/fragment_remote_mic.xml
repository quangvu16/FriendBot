<?xml version="1.0" encoding="utf-8"?>
<!-- Remote Mic / Internet Mic (shared layout), robotic design "FriendBot Robotic Mic Pages":
     black ground, glowing cyan, monospace status. Top: kicker, title, link pill with a status
     light. Middle: one big round mic with a pulsing ring and nine level bars. Bottom: network
     line and the scan button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/kickerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.24"
        android:text="@string/mic_kicker_lan"
        android:textColor="#6FA8B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/tile_remote_mic"
        android:textColor="#FFFFFF"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/connectionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/mic_link_pill"
        android:drawableStart="@drawable/mic_status_dot"
        android:drawablePadding="10dp"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:maxLines="2"
        android:minHeight="44dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/voice_relay_searching"
        android:textAllCaps="true"
        android:textColor="#CFF6FF"
        android:textSize="12sp"
        tools:text="Linked · Joy 4 · WiFi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp">

            <View
                android:id="@+id/pulseRing"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/mic_ring_pulse" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mic_ring_dashed" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_orb_idle"
                android:contentDescription="@string/remote_mic_tap_to_start"
                android:elevation="6dp"
                android:padding="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="#7FE7FF" />
        </FrameLayout>

        <org.openbot.app.robot.voice.MicLevelView
            android:id="@+id/levelBars"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="@string/remote_mic_tap_to_start"
            android:textAllCaps="true"
            android:textColor="#E6F9FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/mic_hint"
            android:textColor="#8FA9B3"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wifiText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:minHeight="32dp"
            android:textAllCaps="true"
            android:textColor="#8FA9B3"
            android:textSize="11sp"
            tools:text="WiFi: Home-5G" />

        <TextView
            android:id="@+id/networkTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/mic_tag_same_network"
            android:textAllCaps="true"
            android:textColor="#8FA9B3"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/scanQrButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/mic_scan_outline"
        android:drawableStart="@drawable/ic_qr_code"
        android:drawablePadding="10dp"
        android:drawableTint="#7FE7FF"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:minHeight="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/remote_mic_scan_qr"
        android:textAllCaps="true"
        android:textColor="#7FE7FF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
