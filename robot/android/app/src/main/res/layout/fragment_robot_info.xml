<?xml version="1.0" encoding="utf-8"?>
<!-- Car setup for the ESP32-S3 Ackermann car (firmware/openbot-esp32s3). It shows only what that
     car has: an ESC for throttle, a steering servo and an RC receiver, plus the object-avoidance
     standoff controls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/robotTypeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="@string/robot_type"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/robotTypeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="@string/n_a"
            android:textColor="@android:color/black" />

        <CheckBox
            android:id="@+id/refreshToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/refresh_toggle"
            android:minWidth="48dp"
            android:padding="8dp"
            tools:ignore="DuplicateSpeakableTextCheck" />

        <CheckBox
            android:id="@+id/usbToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/usb_toggle"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/bleToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:button="@drawable/ble_toggle"
            android:padding="8dp" />

    </LinearLayout>

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/robot_icon"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:contentDescription="@string/robot_icon"
        android:padding="8dp"
        android:src="@drawable/ic_openbot" />

    <TextView
        android:id="@+id/drive_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/setup_drive_unknown"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/featuresText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/setup_features"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/feat_rc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_rc" />
        </LinearLayout>
    </LinearLayout>

    <!-- SensorServer WebSocket link (sensor_link_control.xml). -->
    <include
        android:id="@+id/sensor_link"
        layout="@layout/sensor_link_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/readingsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/readings"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:text="@string/setup_rc_mode"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/rc_mode_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="@string/n_a"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:text="@string/setup_link"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/link_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="@string/n_a"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sendCommandsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/send_commands"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/motors"
            android:textColor="@android:color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/motors_forward_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/forward"
            android:tooltipText="@string/forward"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_arrow_upward"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/motors_backward_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/backward"
            android:tooltipText="@string/backward"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_arrow_downward"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/motors_stop_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/stop"
            android:tooltipText="@string/stop"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_stop"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/setup_steering"
            android:textColor="@android:color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/steer_left_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/setup_left"
            android:tooltipText="@string/setup_left"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_turn_left"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/steer_center_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/setup_centre"
            android:tooltipText="@string/setup_centre"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_straight"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/steer_right_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            app:cornerRadius="12dp"
            android:contentDescription="@string/setup_right"
            android:tooltipText="@string/setup_right"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck"
            app:icon="@drawable/ic_btn_turn_right"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="#FFFFFF"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:text="@string/setup_test_note"
        android:textColor="#666666"
        android:textSize="12sp" />

    <!-- AVOID_MARGIN analog: how far from a barrier the car holds. The quick-disable switch lives
         on the FreeRoam driving screen, where it can actually be reached in a hurry. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avoid_margin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="end"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/avoidMargin"
            android:textColor="@android:color/black" />

        <com.google.android.material.slider.Slider
            android:id="@+id/avoid_margin_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:contentDescription="@string/avoidMargin"
            android:padding="4dp"
            android:stepSize="0.1"
            android:valueFrom="0.3"
            android:valueTo="3.0"
            app:thumbColor="@color/openBotBlue"
            app:trackColorActive="@color/openBotBlue" />

        <TextView
            android:id="@+id/avoid_margin_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="32dp"
            android:padding="4dp"
            android:textColor="@android:color/black"
            tools:text="1.0 m" />
    </LinearLayout>

    <!-- AVOID_BACKUP_SPD analog: reverse command used to back away and restore the margin when
         something closes in from the front. 0 (the ArduPilot default) disables backing away. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avoid_backup_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="end"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/avoidBackup"
            android:textColor="@android:color/black" />

        <com.google.android.material.slider.Slider
            android:id="@+id/avoid_backup_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:contentDescription="@string/avoidBackup"
            android:padding="4dp"
            android:stepSize="0.05"
            android:valueFrom="0.0"
            android:valueTo="0.5"
            app:thumbColor="@color/openBotBlue"
            app:trackColorActive="@color/openBotBlue" />

        <TextView
            android:id="@+id/avoid_backup_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="32dp"
            android:padding="4dp"
            android:textColor="@android:color/black"
            tools:text="Off" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
