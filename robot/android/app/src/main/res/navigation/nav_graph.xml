<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="org.openbot.app.robot.main.MainFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_freeRoamFragment"
            app:destination="@id/freeRoamFragment" />
        <action
            android:id="@+id/action_mainFragment_to_gpsNavigationFragment"
            app:destination="@id/gpsNavigationFragment" />
        <action
            android:id="@+id/action_mainFragment_to_loggerFragment"
            app:destination="@id/loggerFragment" />
        <action
            android:id="@+id/action_mainFragment_to_autopilotFragment"
            app:destination="@id/AIFragment" />
        <action
            android:id="@+id/action_mainFragment_to_controllerMappingFragment"
            app:destination="@id/controllerMappingFragment" />
        <action
            android:id="@+id/action_mainFragment_to_objectNavFragment"
            app:destination="@id/objectNavFragment" />
        <action
            android:id="@+id/action_mainFragment_to_modelManagementFragment"
            app:destination="@id/modelManagementFragment" />
        <action
            android:id="@+id/action_mainFragment_to_pointGoalNavigationFragment"
            app:destination="@id/pointGoalNavigationFragment" />
        <action
            android:id="@+id/action_mainFragment_to_pointGoalNavigationFragment2"
            app:destination="@id/pointGoalNavigationFragment" />
        <action
            android:id="@+id/action_mainFragment_to_robotInfoFragment"
            app:destination="@id/robotInfoFragment" />
        <action
            android:id="@+id/action_mainFragment_to_voiceControlFragment"
            app:destination="@id/voiceControlFragment" />
        <action
            android:id="@+id/action_mainFragment_to_remoteMicFragment"
            app:destination="@id/remoteMicFragment" />
        <action
            android:id="@+id/action_mainFragment_to_followColourFragment"
            app:destination="@id/followColourFragment" />
        <action
            android:id="@+id/action_mainFragment_to_followFaceFragment"
            app:destination="@id/followFaceFragment" />
        <action
            android:id="@+id/action_mainFragment_to_followLineFragment"
            app:destination="@id/followLineFragment" />
        <action
            android:id="@+id/action_mainFragment_to_avoidObjectFragment"
            app:destination="@id/avoidObjectFragment" />
        <action
            android:id="@+id/action_mainFragment_to_targetTrackingFragment"
            app:destination="@id/targetTrackingFragment" />
        <action
            android:id="@+id/action_mainFragment_to_guideFragment"
            app:destination="@id/guideFragment" />
    </fragment>

    <fragment
        android:id="@+id/freeRoamFragment"
        android:name="org.openbot.app.robot.robot.FreeRoamFragment"
        android:label="FreeRoamFragment"
        tools:layout="@layout/fragment_free_roam" />

    <fragment
        android:id="@+id/gpsNavigationFragment"
        android:name="org.openbot.app.robot.gpsNav.GpsNavigationFragment"
        android:label="@string/tile_gps_navigation"
        tools:layout="@layout/fragment_gps_navigation" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="org.openbot.app.robot.main.SettingsFragment"
        android:label="@string/settings" />

    <action
        android:id="@+id/open_settings_fragment"
        app:destination="@id/settingsFragment"
        />

    <fragment
        android:id="@+id/bluetoothFragment"
        android:name="org.openbot.app.robot.main.BluetoothFragment"
        android:label="@string/bluetooth" />

    <action
        android:id="@+id/open_bluetooth_fragment"
        app:destination="@id/bluetoothFragment" />

    <fragment
        android:id="@+id/usbFragment"
        android:name="org.openbot.app.robot.main.UsbFragment"
        android:label="@string/usb" />

    <action
        android:id="@+id/open_usb_fragment"
        app:destination="@id/usbFragment"
        />

    <fragment
        android:id="@+id/loggerFragment"
        android:name="org.openbot.app.robot.logging.LoggerFragment"
        android:label="fragment_logger"
        tools:layout="@layout/fragment_logger" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="org.openbot.app.robot.profile.ProfileFragment"
        android:label="My Profile" >
        <action
            android:id="@+id/action_profileFragment_to_EditProfileFragment"
            app:destination="@id/EditProfileFragment" />
    </fragment>

    <action
        android:id="@+id/open_profile_fragment"
        app:destination="@id/profileFragment" />
    <fragment
        android:id="@+id/AIFragment"
        android:name="org.openbot.app.robot.autopilot.AutopilotFragment"
        android:label="fragment_ai"
        tools:layout="@layout/fragment_autopilot" />

    <fragment
        android:id="@+id/controllerMappingFragment"
        android:name="org.openbot.app.robot.controller.ControllerMappingFragment"
        android:label="fragment_controller_mapping"
        tools:layout="@layout/fragment_controller_mapping" />
    <fragment
        android:id="@+id/objectNavFragment"
        android:name="org.openbot.app.robot.objectNav.ObjectNavFragment"
        android:label="fragment_object_nav"
        tools:layout="@layout/fragment_object_nav" />

    <fragment
        android:id="@+id/modelManagementFragment"
        android:name="org.openbot.app.robot.modelManagement.ModelManagementFragment"
        android:label="fragment_model_management"
        tools:layout="@layout/fragment_model_management" />
    <fragment
        android:id="@+id/pointGoalNavigationFragment"
        android:name="org.openbot.app.robot.pointGoalNavigation.PointGoalNavigationFragment"
        android:label="fragment_point_goal_navigation"
        tools:layout="@layout/fragment_point_goal_navigation" />

    <fragment
        android:id="@+id/EditProfileFragment"
        android:name="org.openbot.app.robot.profile.EditProfileFragment"
        android:label="editProfile"
        tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/robotInfoFragment"
        android:name="org.openbot.app.robot.robot.RobotInfoFragment"
        android:label="RobotInfoFragment" />

    <fragment
        android:id="@+id/voiceControlFragment"
        android:name="org.openbot.app.robot.voice.VoiceControlFragment"
        android:label="@string/tile_voice_control"
        tools:layout="@layout/fragment_voice_control" />

    <fragment
        android:id="@+id/remoteMicFragment"
        android:name="org.openbot.app.robot.voice.RemoteMicFragment"
        android:label="@string/tile_remote_mic"
        tools:layout="@layout/fragment_remote_mic" />

    <fragment
        android:id="@+id/followColourFragment"
        android:name="org.openbot.app.robot.vision.FollowColourFragment"
        android:label="@string/tile_follow_colour"
        tools:layout="@layout/fragment_vision_mode" />

    <fragment
        android:id="@+id/followFaceFragment"
        android:name="org.openbot.app.robot.vision.FollowFaceFragment"
        android:label="@string/tile_follow_face"
        tools:layout="@layout/fragment_vision_mode" />

    <fragment
        android:id="@+id/followLineFragment"
        android:name="org.openbot.app.robot.vision.FollowLineFragment"
        android:label="@string/tile_follow_line"
        tools:layout="@layout/fragment_vision_mode" />

    <fragment
        android:id="@+id/avoidObjectFragment"
        android:name="org.openbot.app.robot.vision.AvoidObjectFragment"
        android:label="@string/tile_object_avoidance"
        tools:layout="@layout/fragment_vision_mode" />

    <fragment
        android:id="@+id/targetTrackingFragment"
        android:name="org.openbot.app.robot.vision.TargetTrackingFragment"
        android:label="@string/tile_target_tracking"
        tools:layout="@layout/fragment_vision_mode" />

    <fragment
        android:id="@+id/guideFragment"
        android:name="org.openbot.app.robot.vision.GuideFragment"
        android:label="@string/tile_guides"
        tools:layout="@layout/fragment_guide">
        <argument
            android:name="guideId"
            app:argType="string" />
    </fragment>
</navigation>