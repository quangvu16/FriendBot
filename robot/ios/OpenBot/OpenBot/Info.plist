<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>FriendBot</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>tflite file</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openbot.tflite</string>
			</array>
		</dict>
	</array>
	<key>CFBundleIcons</key>
	<dict/>
	<key>CFBundleIcons~ipad</key>
	<dict/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>zh-Hans</string>
		<string>ko</string>
		<string>hi</string>
	</array>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>http</string>
		<string>https</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_openbot._tcp.</string>
		<string>_openbot-server._tcp.</string>
		<string>_friendbot-ctrl._tcp.</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>When you ask the assistant to see something on the Voice Control page, it takes one photo with this phone's camera and asks Xiaozhi to explain the environment. The Remote Mic page also uses the camera to scan the robot phone's QR code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FriendBot talks to controllers on your Wi-Fi network, and shares or reads phone sensors over the Sensor link.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice control sends your microphone to Xiaozhi so the assistant can hear your commands. The Remote Mic page streams this phone's microphone into the voice control page on the phone connected to the robot.</string>
	<key>NSMotionUsageDescription</key>
	<string>The barometer and motion sensors give height, heading and tilt for the map and the sensor link.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>The Voice Grab page turns what you say (for example "bring me the cup") into robot actions.</string>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Gilroy-Regular.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>tflite File data</string>
			<key>UTTypeIconFiles</key>
			<array/>
			<key>UTTypeIdentifier</key>
			<string>com.openbot.tflite</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tflite</string>
					<string>TFLITE</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>kTCCServiceMediaLibrary</key>
	<string>Allow Audio Player for sound mode</string>
</dict>
</plist>
